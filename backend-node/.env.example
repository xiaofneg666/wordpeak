# 词峰 WORDPEAK 后端环境变量(复制为 .env 后填写;系统环境变量优先,不覆盖)
# AI 翻译/发音建议:任配其一即可启用,日记的中文→英文翻译需要它
# Anthropic(推荐);走中转时另配 BASE_URL 和 MODEL(如中转的模型名 SYKJ)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# Google Gemini(备选)
GEMINI_API_KEY=
# 数据库驱动:sqlite(默认,零配置)或 mysql(按下例配置;wordpeak 为本机库名)
WORDPEAK_DB=mysql
WORDPEAK_MYSQL_HOST=127.0.0.1
WORDPEAK_MYSQL_PORT=3306
WORDPEAK_MYSQL_USER=root
WORDPEAK_MYSQL_PASSWORD=
WORDPEAK_MYSQL_DATABASE=wordpeak

